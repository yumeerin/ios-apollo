@@ -135,12 +136,27 @@
 static void
 dma_sync(uint32_t off, uint32_t len)
 {
+	/*
+	 * A dma-pa buffer is mapped through ml_io_map (uncached device memory).
+	 * Cache maintenance by physical address would panic in phystokv_range()
+	 * when the address is below the highmem dram base (r8q: 0xaf01f000 vs
+	 * gPhysBase 0x100000000). The mapping is already coherent, so only a
+	 * barrier is needed.
+	 */
+	if (su.dma_uncached) {
+		__builtin_arm_dsb(0xf);
+		return;
+	}
 	flush_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
 }
 
 static void
 dma_clean(uint32_t off, uint32_t len)
 {
+	if (su.dma_uncached) {
+		__builtin_arm_dsb(0xf);
+		return;
+	}
 	clean_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
 }
 
