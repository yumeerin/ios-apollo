 	clean_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
+}
+
+/*
+ * Zero part of the DMA buffer with ordinary aligned stores. bzero() uses
+ * DC ZVA for larger sizes, and DC ZVA is not permitted on the Device-nGnRnE
+ * mapping that ml_io_map() creates for a dma-pa buffer: it takes an alignment
+ * fault in the kernel. Volatile 64-bit stores stay plain stores.
+ */
+static void
+dma_zero(uint32_t off, uint32_t len)
+{
+	volatile uint64_t *p = (volatile uint64_t *)(su.dma + off);
+
+	for (uint32_t done = 0; done < len; done += sizeof(*p)) {
+		*p++ = 0;
+	}
 }
 
