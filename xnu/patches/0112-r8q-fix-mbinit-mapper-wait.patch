+
+/*
+ * Called from the platform expert when IOKit matching is skipped. Without a
+ * running IOPlatformExpert the system mapper would stay kUnknown, and the
+ * first IOMapperIOVMAlloc() (mbinit) would sleep forever in
+ * waitForSystemMapper(). Publish "no mapper" so DMA clients fall back to
+ * identity mappings.
+ */
+void
+IOMapperClearSystemMapper(void)
+{
+	sMapperLock.lock();
+	IOMapper::gSystem = NULL;
+	sMapperLock.unlock();
+	sMapperLock.wakeup(&IOMapper::gSystem);
 }
 
